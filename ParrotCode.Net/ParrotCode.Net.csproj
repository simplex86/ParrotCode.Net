<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ParrotCode</RootNamespace>
    <AssemblyName>ParrotCode.Net</AssemblyName>
    <!-- dotnet run 时工作目录设为项目目录，使 .parrotcode.yaml 能被三级发现命中 -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Terminal.Gui" Version="2.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ParrotCode.Net-xUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- 迭代 12：Builtin Skill 文件部署到输出目录（跨平台用 Path.Combine 定位） -->
    <Content Include="Skills\Builtin\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 迭代 14a：Builtin 角色文件部署到输出目录 -->
    <Content Include="SubAgent\Roles\Builtin\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
